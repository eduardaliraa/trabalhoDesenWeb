<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/filmes.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Detalhes do Filme</h1>

  <div class="text-center">

    <h2>{{filme.nome}}</h2>

    <p>
      <strong>Ano:</strong> {{filme.ano}}
    </p>

  </div>

  <hr>

  <h3 class="text-center mb-4">Diretor</h3>

  {{#if filme.diretor}}

    <div class="text-center">

      <p>
        <strong>Nome:</strong>
        {{filme.diretor.nome}}
      </p>

      <p>
        <strong>Ano de nascimento:</strong>
        {{filme.diretor.anoNascimento}}
      </p>

      <p>
        <strong>Nacionalidade:</strong>
        {{filme.diretor.nacionalidade}}
      </p>

    </div>

  {{else}}

    <p class="text-center">
      Este filme ainda não possui diretor cadastrado.
    </p>

  {{/if}}

  <hr>

  <h3 class="text-center mb-4">Artistas</h3>

  {{#if filme.artistas}}

    <div class="text-center">

      {{#each filme.artistas}}

        <div class="mb-3">

          <p>
            <strong>Nome:</strong>
            {{nome}}
          </p>

          {{#if nomeArtistico}}

            <p>
              <strong>Nome artístico:</strong>
              {{nomeArtistico}}
            </p>

          {{/if}}

        </div>

      {{/each}}

    </div>

  {{else}}

    <p class="text-center">
      Este filme ainda não possui artistas cadastrados.
    </p>

  {{/if}}

  <hr>

  <div class="text-center mt-4">

    <a
      href="/filmes/{{filme.id}}/editar"
      class="btn btn-cadastrar"
    >
      Editar filme
    </a>

    <a
      href="/filmes"
      class="btn btn-ver"
    >
      Voltar para lista de filmes
    </a>

  </div>

</div>