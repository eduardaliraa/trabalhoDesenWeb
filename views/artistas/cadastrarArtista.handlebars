<h1>Cadastrar Artista</h1>

<form action="/artistas" method="POST">

  <div>
    <label>Nome do Artista:</label>
    <input type="text" name="nome" required>
  </div>

  <br>

  <div>
    <label>Ano de nascimento:</label>
    <input type="number" name="anoNascimento">
  </div>

  <br>

  <div>
    <label>Está em atividade?</label>
    <input type="checkbox" name="emAtividade" value="true">
    <span>Sim</span>
  </div>

  <br>

  <div>
    <label>Nome artístico:</label>
    <input type="text" name="nomeArtistico">
  </div>

  <br>

  <button type="submit">Cadastrar</button>

</form>

<br>

<a href="/artistas">
  Voltar para lista
</a>