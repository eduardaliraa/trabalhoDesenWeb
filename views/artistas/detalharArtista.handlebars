<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Detalhes do Artista</h1>

  <div class="text-center">

    <h2>{{artista.nome}}</h2>

    <p>
      <strong>Nome artístico:</strong>
      {{artista.nomeArtistico}}
    </p>

    <p>
      <strong>Ano de nascimento:</strong>
      {{artista.anoNascimento}}
    </p>

    <p>
      <strong>Está em atividade:</strong>

      {{#if artista.emAtividade}}
        Sim
      {{else}}
        Não
      {{/if}}

    </p>

  </div>

  <hr>

  <div class="text-center mt-4">

    <a
      href="/artistas/{{artista.id}}/editar"
      class="btn btn-cadastrar"
    >
      Editar artista
    </a>

    <a
      href="/artistas"
      class="btn btn-ver"
    >
      Voltar para lista
    </a>

  </div>

</div>