<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Lista de Fichas Técnicas</h1>

  <div class="text-center mb-4">

    <a
      href="/fichatecnica/cadastrar"
      class="btn btn-cadastrar"
    >
      Cadastrar Ficha Técnica
    </a>

  </div>

  <hr>

  {{#each fichas}}

    <div class="text-center mb-4">

      <h3>
        {{#if filme}}
          {{filme.nome}}
        {{else}}
          Filme não informado
        {{/if}}
      </h3>

      <p>
        <strong>Duração:</strong>
        {{duracaoMinutos}} minutos
      </p>

      <p>
        <strong>Orçamento:</strong>
        {{orcamento}}
      </p>

      <p>
        <strong>Bilheteria:</strong>
        {{bilheteria}}
      </p>

      <a
        href="/fichatecnica/{{id}}"
        class="btn btn-ver"
      >
        Ver detalhes
      </a>

      <a
  href="/fichatecnica/{{id}}/editar"
  class="btn btn-cadastrar"
>
  Editar
</a>

    </div>

    <hr>

  {{else}}

    <p class="text-center">
      Nenhuma ficha técnica cadastrada.
    </p>

  {{/each}}

  <div class="text-center mt-4">

    <a href="/" class="btn btn-ver">
      Voltar para página inicial
    </a>

  </div>

</div>