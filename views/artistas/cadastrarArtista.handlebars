<h1>Cadastrar Artista</h1 class="text-center" >

<form action="/artistas" method="POST">

  <div>
    <label><strong>Nome do Artista:</strong></label>
    <input type="text" name="nome" required>
  </div>

  <br>

  <div>
    <label><strong>Ano de nascimento:</strong></label>
    <input type="number" name="anoNascimento">
  </div>

  <br>

  <div>
    <label><strong>Está em atividade?</strong></label>
    <input type="checkbox" name="emAtividade" value="true">
    <span>Sim</span>
  </div>

  <br>

  <div>
    <label><strong>Nome artístico:</strong></label>
    <input type="text" name="nomeArtistico">
  </div>

  <br>

  <button type="submit" class="btn btn-cadastrar">Cadastrar</button>

</form>

<br>

<a href="/artistas" class="btn btn-ver">
  Voltar para lista
</a>