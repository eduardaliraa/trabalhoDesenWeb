<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Cadastrar Ficha Técnica</h1>

  {{#if filme}}

    <div class="text-center mb-4">

      <h2>Filme: {{filme.nome}}</h2>

    </div>

    <form action="/filmes/{{filme.id}}/ficha-tecnica" method="POST">

      <input
        type="hidden"
        name="filmeId"
        value="{{filme.id}}"
      >

      <div class="mb-3">

        <label class="form-label">
          <strong>Duração (minutos):</strong>
        </label>

        <input
          type="number"
          name="duracaoMinutos"
          class="form-control"
        >

      </div>

      <div class="mb-3">

        <label class="form-label">
          <strong>Orçamento:</strong>
        </label>

        <input
          type="number"
          step="0.01"
          name="orcamento"
          class="form-control"
        >

      </div>

      <div class="mb-3">

        <label class="form-label">
          <strong>Bilheteria:</strong>
        </label>

        <input
          type="number"
          step="0.01"
          name="bilheteria"
          class="form-control"
        >

      </div>

      <div class="text-center mt-4">

        <button
          type="submit"
          class="btn btn-cadastrar"
        >
          Salvar
        </button>

        <a
          href="/fichatecnica"
          class="btn btn-ver"
        >
          Voltar para lista
        </a>

      </div>

    </form>

  {{else}}

    <form action="/fichatecnica" method="POST">

      <div class="mb-3">

        <label class="form-label">
          <strong>Filme:</strong>
        </label>

        <select
          name="filmeId"
          class="form-select"
          required
        >

          <option value="">
            Selecione um filme
          </option>

          {{#each filmes}}

            <option value="{{id}}">
              {{nome}} ({{ano}})
            </option>

          {{/each}}

        </select>

      </div>

      <div class="mb-3">

        <label class="form-label">
          <strong>Duração (minutos):</strong>
        </label>

        <input
          type="number"
          name="duracaoMinutos"
          class="form-control"
        >

      </div>

      <div class="mb-3">

        <label class="form-label">
          <strong>Orçamento:</strong>
        </label>

        <input
          type="number"
          step="0.01"
          name="orcamento"
          class="form-control"
        >

      </div>

      <div class="mb-3">

        <label class="form-label">
          <strong>Bilheteria:</strong>
        </label>

        <input
          type="number"
          step="0.01"
          name="bilheteria"
          class="form-control"
        >

      </div>

      <div class="text-center mt-4">

        <button
          type="submit"
          class="btn btn-cadastrar"
        >
          Salvar
        </button>

        <a
          href="/fichatecnica"
          class="btn btn-ver"
        >
          Voltar para lista
        </a>

      </div>

    </form>

  {{/if}}

</div>