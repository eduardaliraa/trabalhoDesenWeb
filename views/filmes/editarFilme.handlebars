<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<h1 class="text-center">Editar Filme</h1>

<form action="/filmes/{{filme.id}}?_method=PUT" method="POST">

  <div class="b">
    <label><strong>Nome do Filme:</strong></label>

<br>

<input
  type="text"
  name="nome"
  value="{{filme.nome}}"
>


  </div>

  <div class="b">
    <label><strong>Ano:</strong></label>

<br>

<input
  type="number"
  name="ano"
  value="{{filme.ano}}"
>


  </div>

  <button type="submit" class="btn btn-ver">
    Editar
  </button>

</form>
