<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<h1 class="text-center">Cadastrar Filme</h1>

<form action="/filmes" method="POST">

<br>

  <div class="b">
    <label><strong>Nome do Filme:</strong></label>
    <input type="text" name="nome" required>
  </div>

  <br>

  <div class="b">
    <label><strong>Ano:</strong></label>
    <input type="number" name="ano" required>
  </div>

  <br>

  <div class="b">
    <label><strong>Diretor:</strong></label>

    <select name="diretorId" required>

      <option value="">
        Selecione um diretor
      </option>

      {{#each diretores}}

        <option value="{{id}}">
          {{nome}}
        </option>

      {{/each}}

    </select>

  </div>

  <br>

  <div >

    <label><strong>Artistas:</strong></label>

    {{#each artistas}}

      <div>
        <input
          type="checkbox"
          name="artistas"
          value="{{id}}"
        >

        <span>{{nome}}</span>

        {{#if nomeArtistico}}
          - {{nomeArtistico}}
        {{/if}}
      </div>

    {{/each}}

  </div>

  <br>

  <button type="submit" class="btn btn-cadastrar">
    Cadastrar
  </button>

</form>

<br>

<a href="/filmes" class="btn btn-ver">
  Voltar para lista
</a>