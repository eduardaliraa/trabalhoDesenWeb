<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<h1>Lista de Artistas</h1>

<a href="/artistas/cadastrar">
  Cadastrar Artista
</a>

<hr>

<ul>

  {{#each artistas}}

    <li>

      <strong>{{nome}}</strong>

    
      <br>

      <a href="/artistas/{{id}}">
        Ver detalhes
      </a>

      <br>
      <br>

      <div>

        <a href="/artistas/{{id}}/editar">
          <i class="fa-solid fa-pen-to-square"></i>
          Editar
        </a>

        <form
          action="/artistas/{{id}}?_method=DELETE"
          method="POST"
          style="display: inline; margin-left: 10px;"
        >
          <button type="submit">
            <i class="fa-solid fa-trash-can"></i>
            Excluir
          </button>
        </form>

      </div>

    </li>

    <hr>

  {{/each}}

</ul>

<a href="/">
  Voltar para página inicial
</a>