<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/filmes.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Editar Filme</h1>

  <form
    action="/filmes/{{filme.id}}?_method=PUT"
    method="POST"
  >

    <div class="mb-3">

      <label class="form-label">
        <strong>Nome do Filme:</strong>
      </label>

      <input
        type="text"
        name="nome"
        value="{{filme.nome}}"
        class="form-control"
        required
      >

    </div>

    <div class="mb-3">

      <label class="form-label">
        <strong>Ano:</strong>
      </label>

      <input
        type="number"
        name="ano"
        value="{{filme.ano}}"
        class="form-control"
      >

    </div>

    <div class="text-center mt-4 botoes">

  <button type="submit" class="btn btn-cadastrar">
    Salvar alterações
  </button>

  <a href="/filmes" class="btn btn-ver">
    Voltar para lista
  </a>

</div>

  </form>

</div>