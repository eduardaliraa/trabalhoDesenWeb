<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-3">{{titulo}}</h1>

  <p class="text-center">
   <i> Bem-vindo ao sistema de filmes.</i> </p>
   <br>
   <p>Aqui você pode gerenciar informações sobre filmes, diretores, artistas e fichas técnicas.
     Use os botões abaixo para navegar pelas diferentes seções do sistema.</p>
  </p>

  <hr>

  <div class="text-center">

    <h2 class="mb-3">Filmes</h2>

    <a href="/filmes" class="btn btn-ver">
      Ver filmes
    </a>

    <a href="/filmes/cadastrar" class="btn btn-cadastrar">
      Cadastrar filme
    </a>

  </div>

  <hr>

  <div class="text-center">

    <h2 class="mb-3">Artistas</h2>

    <a href="/artistas" class="btn btn-ver">
      Ver artistas
    </a>

    <a href="/artistas/cadastrar" class="btn btn-cadastrar">
      Cadastrar artista
    </a>

  </div>

  <hr>

  <div class="text-center">

    <h2 class="mb-3">Diretores</h2>

    <a href="/diretores" class="btn btn-ver">
      Ver diretores
    </a>

    <a href="/diretores/cadastrar" class="btn btn-cadastrar">
      Cadastrar diretor
    </a>

  </div>

  <hr>

  <div class="text-center">

    <h2 class="mb-3">Fichas Técnicas</h2>

    <a href="/fichatecnica" class="btn btn-ver">
      Ver fichas técnicas
    </a>

    <a href="/fichatecnica/cadastrar" class="btn btn-cadastrar">
      Cadastrar ficha técnica
    </a>

  </div>

</div>