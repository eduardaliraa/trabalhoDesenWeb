<h1>Detalhes do Artista</h1 class="text-center">

<h2>{{artista.nome}}</h2>

<br>

<p>
  <strong>Nome artístico:</strong>
  {{artista.nomeArtistico}}
</p>

<p>
  <strong>Ano de nascimento:</strong>
  {{artista.anoNascimento}}
</p>

<p>
  <strong>Está em atividade:</strong>

  {{#if artista.emAtividade}}
    Sim
  {{else}}
    Não
  {{/if}}
</p>

<br>

<a href="/artistas/{{artista.id}}/editar" class="btn btn-cadastrar">
  Editar artista
</a>

<br>
<br>

<a href="/artistas" class="btn btn-ver">
  Voltar para lista
</a>