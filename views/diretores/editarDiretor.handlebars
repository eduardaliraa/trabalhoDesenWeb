<h1>Editar Diretor</h1>

<form action="/diretores/{{diretor.id}}" method="POST">

  <input type="hidden" name="_method" value="PUT">

  <div>
    <label>Nome do Diretor:</label>

    <input
      type="text"
      name="nome"
      value="{{diretor.nome}}"
      required
    >
  </div>

  <br>

  <div>
    <label>Ano de nascimento:</label>

    <input
      type="number"
      name="anoNascimento"
      value="{{diretor.anoNascimento}}"
    >
  </div>

  <br>

  <div>
    <label>Nacionalidade:</label>

    <input
      type="text"
      name="nacionalidade"
      value="{{diretor.nacionalidade}}"
    >
  </div>

  <br>

  <button type="submit">
    Salvar alterações
  </button>

</form>

<br>

<a href="/diretores">
  Voltar para lista
</a>