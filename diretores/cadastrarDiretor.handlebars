<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Cadastrar Diretor</h1>

  <form action="/diretores" method="POST">

    <div class="mb-3">
      <label class="form-label">
        Nome do Diretor:
      </label>

      <input
        type="text"
        name="nome"
        class="form-control"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">
        Ano de nascimento:
      </label>

      <input
        type="number"
        name="anoNascimento"
        class="form-control"
      >
    </div>

    <div class="mb-3">
      <label class="form-label">
        Nacionalidade:
      </label>

      <input
        type="text"
        name="nacionalidade"
        class="form-control"
      >
    </div>

    <div class="text-center">

      <button type="submit" class="btn btn-cadastrar">
        Cadastrar
      </button>

      <a href="/diretores" class="btn btn-ver">
        Voltar para lista
      </a>

    </div>

  </form>

</div>