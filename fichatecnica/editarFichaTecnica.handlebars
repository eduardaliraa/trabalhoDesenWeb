<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<div class="container mt-4">

  <h1 class="text-center mb-4">Editar Ficha Técnica</h1>

  {{#if ficha.filme}}

    <div class="text-center mb-4">
      <h2>Filme: {{ficha.filme.nome}}</h2>
    </div>

  {{/if}}

  <form
    action="/fichatecnica/{{ficha.id}}?_method=PUT"
    method="POST"
  >

    <div class="mb-3">

      <label class="form-label">
        <strong>Duração (minutos):</strong>
      </label>

      <input
        type="number"
        name="duracaoMinutos"
        value="{{ficha.duracaoMinutos}}"
        class="form-control"
      >

    </div>

    <div class="mb-3">

      <label class="form-label">
        <strong>Orçamento:</strong>
      </label>

      <input
        type="number"
        step="0.01"
        name="orcamento"
        value="{{ficha.orcamento}}"
        class="form-control"
      >

    </div>

    <div class="mb-3">

      <label class="form-label">
        <strong>Bilheteria:</strong>
      </label>

      <input
        type="number"
        step="0.01"
        name="bilheteria"
        value="{{ficha.bilheteria}}"
        class="form-control"
      >

    </div>

    <div class="text-center mt-4">

      <button
        type="submit"
        class="btn btn-cadastrar"
      >
        Salvar alterações
      </button>

      <a
        href="/fichatecnica"
        class="btn btn-ver"
      >
        Voltar para lista
      </a>

    </div>

  </form>

</div>