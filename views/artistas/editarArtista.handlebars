<h1>Editar Artista</h1 class="text-center">

<form action="/artistas/{{artista.id}}" method="POST">

  <input type="hidden" name="_method" value="PUT">

  <div>
    <label><strong>Nome do Artista:</strong></label>
    <input
      type="text"
      name="nome"
      value="{{artista.nome}}"
      required
    >
  </div>

  <br>

  <div>
    <label><strong>Ano de nascimento:</strong></label>
    <input
      type="number"
      name="anoNascimento"
      value="{{artista.anoNascimento}}"
    >
  </div>

  <br>

  <div>
    <label><strong>Está em atividade?</strong></label>

    <input
      type="checkbox"
      name="emAtividade"
      value="true"
      {{#if artista.emAtividade}}checked{{/if}}
    >

    <span>Sim</span>
  </div>

  <br>

  <div>
    <label><strong>Nome artístico:</strong></label>

    <input
      type="text"
      name="nomeArtistico"
      value="{{artista.nomeArtistico}}"
    >
  </div>

  <br>

  <button type="submit" class="btn btn-cadastrar">
    Salvar alterações
  </button>

</form>

<br>

<a href="/artistas" class="btn btn-ver">
  Voltar para lista
</a>