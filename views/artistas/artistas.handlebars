<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/style.css">

<h1>Lista de Artistas</h1 class="text-center">

<a href="/artistas/cadastrar" class="btn btn-cadastrar">
  Cadastrar Artista
</a>

<hr>

<ul>

  {{#each artistas}}

    <li>

      <strong>{{nome}}</strong>

      <br>
      <br>

      <a href="/artistas/{{id}}" class="btn btn-ver">
        Ver detalhes
      </a>

      <br>
      <br>

      <div>

        <a href="/artistas/{{id}}/editar" class ="btn btn-cadastrar">
          <i class="fa-solid fa-pen-to-square"></i>
          Editar
        </a>

        <form
          action="/artistas/{{id}}?_method=DELETE"
          method="POST"
          style="display: inline; margin-left: 10px;"
        >
          <button type="submit" class="btn btn-cadastrar">
            <i class="fa-solid fa-trash-can"></i>
            Excluir
          </button>
        </form>

      </div>

    </li>

    <hr>

  {{/each}}

</ul>

<a href="/" class="btn btn-ver">
  Voltar para página inicial
</a>